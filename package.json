{
  "name": "neon-torino",
  "private": true,
  "type": "module",
  "description": "3D open-world game set in Santa Rita (Turin), built on OpenStreetMap data",
  "scripts": {
    "dev": "node tools/serve.mjs",
    "map": "python3 tools/build_map.py",
    "osm": "python3 tools/fetch_osm.py",
    "test": "node tests/smoke.mjs",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.mjs\" \"tools/**/*.mjs\""
  },
  "devDependencies": {
    "three": "0.160.0",
    "prettier": "3.10.1"
  }
}
